# =============================================================================
# CyberBLADE environment template. Every value here is a placeholder; production refuses to
# start with placeholder values (lib/config/runtime-config.ts). NEVER commit real keys.
# Vercel: set Production and Preview separately (docs/ops/deploy-vercel.md, step 4). Preview
# deployments use the STAGING Supabase project only.
#   [public]  inlined into the browser bundle (NEXT_PUBLIC_*): never put secrets here
#   [server]  server-only; read in route handlers, server actions and scripts
#   [req]     required in production
# =============================================================================

# --- Hosted Supabase -------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co          # [public][req]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-jwt-key              # [public][req]
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key            # [server][req] bypasses RLS
NEXT_PUBLIC_SITE_URL=https://beta.example.com                       # [public][req] https origin used for auth redirects

# --- Background jobs (Vercel Cron sends Authorization: Bearer $CRON_SECRET) -------------------
CRON_SECRET=replace-with-at-least-32-random-characters              # [server][req] openssl rand -hex 32

# --- Closed beta ------------------------------------------------------------------------------
BETA_INVITE_ONLY=true                                               # [server][req] sign-up needs an invite code
# BETA_NOINDEX=true                                                 # [server] defaults to BETA_INVITE_ONLY
MAINTENANCE_MODE=false                                              # [server] true = 503 + Retry-After everywhere except /api/health
MAINTENANCE_RETRY_AFTER_SECONDS=600                                 # [server]
# RATE_LIMIT_BACKEND=postgres                                       # [server] postgres (default when hosted) | memory (local only; refused in production)

# --- Local-only storage (ignored when hosted; the file store is refused on Vercel) -------------
NEON_DATA_DIR=.data                                                 # [server]
NEON_SHOW_DRAFTS=true                                               # [server] all lessons are drafts; see decisions log before a beta

# --- SOC track flags (beta: everything below on; L2 & rules ready per Entry 17 audit; default off for staged rollout) ---
SOC_WORKSPACE_ENABLED=true
SOC_ENRICHMENT_ENABLED=true
SOC_QUERY_ENABLED=true
SOC_REPORTS_ENABLED=true
SOC_EXAMS_ENABLED=true
SOC_HANDLER_ENABLED=true
SOC_L2_ENABLED=false                                                # built & audited in Entry 16/17; default false for staged beta rollout
SOC_RULES_ENABLED=false                                             # built & audited in Entry 16/17; default false for staged beta rollout

# --- Penetration Testing track flags (default off; server-side gated) -----------------------------
PENTEST_ENABLED=false
PENTEST_EXAMS_ENABLED=false

# --- The Handler (AI tutor) -------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key                                  # [server]
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-api-key                                      # [server]
GROQ_MODEL=llama-3.3-70b-versatile
HANDLER_DAILY_REQUEST_LIMIT=50                                      # per learner per day
HANDLER_DAILY_TOKEN_LIMIT=50000                                     # per learner per day
HANDLER_GLOBAL_DAILY_TOKEN_LIMIT=500000                             # whole platform per day
HANDLER_MAX_GLOBAL_DAILY_BUDGET_USD=10.00
# HANDLER_DEBUG_LOGS=false                                          # refused in production

# --- SOC report AI feedback (off for the beta) -----------------------------------------------
SOC_AI_GRADING_MODE=off                                             # off | shadow | preview | live (live needs a signed gate file)
SOC_AI_GRADING_KILL_SWITCH=0                                        # 1 stops all AI grading immediately
SOC_AI_GRADING_MODEL_ID=
# SOC_AI_PROVIDER=                                                  # mock is refused in production

# --- Optional ---------------------------------------------------------------------------------
# CAPTCHA_SECRET_KEY=                                               # [server]
# ERROR_REPORTER_DSN=                                               # [server] Sentry-compatible; events are scrubbed, no learner content
# CYBERBLADE_ALLOW_LOCAL_E2E=                                       # Playwright only; refused on Vercel
# CYBERBLADE_SHOW_DEV_UI=                                           # refused in production

# --- Operator scripts only: NEVER set these in Vercel ----------------------------------------
# SUPABASE_DB_URL=postgresql://...                                  # npm run db:backup
# BACKUP_ENCRYPTION_KEY=                                            # base64 of 32 random bytes; keep in a password manager
# BACKUP_DIR=                                                       # folder OUTSIDE the repo
# BACKUP_KEEP=14
# HANDLER_PRICE_PER_1M_TOKENS_USD=0.60                              # npm run ops:daily spend estimate
# STAGING_VERIFY_CONFIRM / STAGING_SUPABASE_* / STAGING_BASE_URL     # npm run staging:verify

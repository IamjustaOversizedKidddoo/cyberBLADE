# =============================================================================
# CyberBLADE Environment Configuration Template
# NOTE: All secret keys are placeholders. NEVER commit real production keys!
# =============================================================================

# --- Storage & Runtime Modes ---
# Local-first data directory (used in development/test fallback only)
NEON_DATA_DIR=.data
NEON_SHOW_DRAFTS=true

# --- Hosted Supabase Backend (Required in production) ---
# Public browser-safe variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-jwt-key

# Server-only administrative key (Bypasses RLS - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Socratic AI Tutor (The Handler) Providers ---
# Primary AI Provider: Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Secondary AI Provider: Groq (Llama-3.3-70b-versatile)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# AI Usage Metering & Global Spend Caps
HANDLER_DAILY_REQUEST_LIMIT=50
HANDLER_DAILY_TOKEN_LIMIT=50000
HANDLER_MAX_GLOBAL_DAILY_BUDGET_USD=10.00

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SocFamily",
  "description": "Procedural scenario family definition for the CyberBLADE SOC workspace",
  "type": "object",
  "required": [
    "metadata",
    "environmentTemplate",
    "incidentTemplates",
    "benignTemplates",
    "variationAxes",
    "debriefTemplates"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "level",
        "skillsTested",
        "estimatedMinutes",
        "difficultyRange",
        "author",
        "reviewStatus"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "enum": ["L1", "L2", "L3"] },
        "skillsTested": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "estimatedMinutes": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 5 },
            "max": { "type": "integer", "maximum": 480 }
          }
        },
        "difficultyRange": {
          "type": "array",
          "items": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
          "minItems": 1
        },
        "author": { "type": "string", "minLength": 1 },
        "reviewStatus": {
          "type": "string",
          "enum": ["draft", "practitioner-reviewed", "approved"]
        },
        "reviewerNotes": { "type": "string" },
        "publishedHash": { "type": "string" }
      }
    },
    "environmentTemplate": {
      "type": "object",
      "required": ["organizationArchetypes", "assetDistribution", "userDistribution"],
      "properties": {
        "organizationArchetypes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "assetDistribution": { "type": "object" },
        "userDistribution": { "type": "object" }
      }
    },
    "incidentTemplates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titleTemplate", "category", "rootCauseTemplate", "stages"],
        "properties": {
          "id": { "type": "string" },
          "titleTemplate": { "type": "string" },
          "category": { "type": "string" },
          "rootCauseTemplate": { "type": "string" },
          "mitreTags": { "type": "array", "items": { "type": "string" } },
          "stages": { "type": "array" }
        }
      },
      "minItems": 1
    },
    "benignTemplates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "frequencyRange", "timePattern", "actorRole", "alertTemplates", "groundTruth"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "frequencyRange": { "type": "object" },
          "timePattern": { "type": "string" },
          "actorRole": { "type": "string" },
          "eventTemplates": { "type": "array" },
          "alertTemplates": { "type": "array" },
          "groundTruth": { "type": "object" }
        }
      },
      "minItems": 1
    },
    "twinTemplates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "variationAxes": {
      "type": "object",
      "required": ["incidentCount", "noiseRatio", "ambiguityCount", "telemetryGapCount", "targetAlertCount", "difficultyProfiles"]
    },
    "debriefTemplates": {
      "type": "object",
      "required": ["overallBriefingTemplate", "generalGuidanceTemplate"]
    },
    "hooks": {
      "type": "object"
    }
  }
}
